# .gitignore

# ─── Python (bot) ───
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.log
.pytest_cache/
.coverage
htmlcov/

# ─── Go (backend) ───
backend/bin/
backend/*.exe
backend/*.test
backend/coverage.out

# ─── Node / React (frontend) ───
node_modules/
frontend/dist/
frontend/build/
frontend/.env.local
frontend/.env.production

# ─── Environment files ───
.env
.env.local
.env.*.local
!.env.example

# ─── IDEs ───
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Docker ───
/postgres-data