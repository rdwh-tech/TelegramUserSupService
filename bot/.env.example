# Токен и ID компании (обязательно. Для привязки)
BOT_TOKEN=123456:replace-with-token-from-BotFather
COMPANY_ID=demo-company

# API-сервис
# stub - заглушка, http - API-сервис
API_MODE=stub
API_BASE_URL=http://localhost:8000
API_TIMEOUT=10

# Redis (состояния FSM) и RabbitMQ (события от сервера)
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost/
MQ_ENABLED=false
MQ_QUEUE=bot_events.demo-company # по умолчанию bot_events.<COMPANY_ID>

# Прочее
LOG_LEVEL=INFO
# true - включить имитацию событий оператора. Только для разработки
DEBUG_COMMANDS=false